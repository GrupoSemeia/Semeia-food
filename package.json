    "test": "node --test scripts/smoke.test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
